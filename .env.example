# ============================================
# ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to Git (contains sensitive data)
# ============================================

# ============================================
# DATABASE CONFIGURATION
# MongoDB Atlas connection string
# ============================================
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
# Get this from MongoDB Atlas Dashboard -> Connect -> Connect your application
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/jobportal

# ============================================
# JWT (JSON Web Token) CONFIGURATION
# Used for user authentication and authorization
# ============================================
# Generate a secure random string (minimum 32 characters recommended)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_minimum_32_characters

# Token expiration time (examples: 1d, 7d, 30d, 24h, 60m)
JWT_EXPIRE=30d

# ============================================
# SERVER CONFIGURATION
# ============================================
# Port number for Express server (default: 5000)
PORT=5000

# Environment mode: development, production, or test
NODE_ENV=development

# ============================================
# CLIENT CONFIGURATION
# Frontend URL for CORS (Cross-Origin Resource Sharing)
# ============================================
# Vite default port is 5173
CLIENT_URL=http://localhost:5173

# ============================================
# FILE UPLOAD SETTINGS (Optional)
# Maximum file size for resume/document uploads
# ============================================
# Size in bytes (5MB = 5000000 bytes)
MAX_FILE_SIZE=5000000

# ============================================
# MAINTENANCE MODE & RATE LIMITING
# ============================================
# Enable to block all API requests except health check (true/false)
MAINTENANCE_MODE=false

# Maximum requests per 15-minute window per IP (default 100)
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# DEMO ACCOUNT SEEDING (Optional)
# ============================================
# Set to true to wipe User/Job collections and insert demo accounts/jobs
SEED_DEMO_ACCOUNTS=false

# Demo account passwords (only used when SEED_DEMO_ACCOUNTS=true)
# Change these before enabling; NEVER use defaults in production
DEMO_JOBSEEKER_PASSWORD=changeMeJobSeeker!
DEMO_EMPLOYER_PASSWORD=changeMeEmployer!

# ============================================
# FILE UPLOAD CONTROL (Future feature)
# ============================================
# Toggle to enable resume/file uploads once secure validation is implemented
ENABLE_FILE_UPLOAD=false

# ============================================
# NOTES FOR SETUP:
# 1. Create MongoDB Atlas account at https://www.mongodb.com/atlas
# 2. Create a cluster and database user
# 3. Whitelist your IP address (0.0.0.0/0 for all IPs during development)
# 4. Get connection string and replace <username>, <password>, <database>
# 5. Generate secure JWT_SECRET using crypto.randomBytes()
# 6. Copy this file to .env and fill in actual values
# 7. Restart server after changing .env values
# ============================================
